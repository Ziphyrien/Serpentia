+// Pseudo-landscape: the app rotates the whole UI 90° clockwise via CSS while
+// portals live on <body> outside the rotated container. Anchored floating
+// content must therefore be placed on the side that corresponds to the
+// user-perceived side after rotation (user-bottom = screen-left, etc.),
+// shifted so the center-rotated box lands on the anchor, and rotated back
+// 90° so its text reads upright. Detected through a marker class the app
+// toggles on <html>; inactive by default, so behavior is unchanged.
+const PSEUDO_LANDSCAPE_SIDE = {
+    top: "right",
+    right: "bottom",
+    bottom: "left",
+    left: "top",
+};
+export function isPseudoLandscapeActive() {
+    return (typeof document !== "undefined" &&
+        document.documentElement.classList.contains("pseudo-landscape"));
+}
+function pseudoLandscapeRotate() {
+    return {
+        name: "pseudoLandscapeRotate",
+        fn(data) {
+            if (!isPseudoLandscapeActive())
+                return {};
+            const delta = (data.rects.floating.width - data.rects.floating.height) / 2;
+            return { x: data.x + delta, y: data.y + delta };
+        },
+    };
+}
